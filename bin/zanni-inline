#!/usr/bin/env node
/* zanni-inline — put a component's defs, styles and script INTO a document.
 *
 * Not a nicety: `filter: url(#id)` resolves only within the same document,
 * and external `url(sprite.svg#id)` is Firefox-only in practice. A linked
 * stylesheet cannot carry boil. So the build step is the delivery mechanism.
 *
 *   zanni-inline [--assets DIR] [--component boil]... IN.html [-o OUT.html]
 *
 * Each component replaces its marker (`<!-- zanni:boil -->`) wherever the
 * author put it — conventionally just inside <body>. Writes to stdout unless
 * -o is given. Exits 2 if a requested component's marker is absent, because
 * a silent no-op is exactly the failure this library exists to prevent.
 */
'use strict';
const fs = require('fs');
const path = require('path');

const argv = process.argv.slice(2);
let assets = process.env.ZANNI_ASSETS || path.join(__dirname, '..', 'assets');
let components = [];
let out = null;
let input = null;
const sets = {};   // --set boil.text.scale=2.4

for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--assets') assets = argv[++i];
  else if (a === '--component' || a === '-c') components.push(argv[++i]);
  else if (a === '-o' || a === '--output') out = argv[++i];
  else if (a === '--set') {
    const kv = argv[++i] || '';
    const eq = kv.indexOf('=');
    if (eq < 0) die('--set wants NAME=VALUE, got: ' + kv);
    sets[kv.slice(0, eq)] = kv.slice(eq + 1);
  }
  else if (a === '-h' || a === '--help') { usage(0); }
  else if (a[0] === '-' && a !== '-') die('unknown flag: ' + a);
  else if (input === null) input = a;
  else die('unexpected argument: ' + a);
}

function usage(code) {
  process.stdout.write(
    'usage: zanni-inline [--assets DIR] [--component NAME]...\n' +
    '                    [--set COMPONENT.KNOB=VALUE]... IN.html [-o OUT.html]\n' +
    '\n' +
    'Knobs are listed per component in assets/manifest.json. An unknown knob is\n' +
    'an error, not a no-op: a setting that quietly does nothing is worse than a\n' +
    'setting that fails.\n' +
    '\n' +
    '  zanni-inline --set boil.driver=smil --set boil.text.scale=3 page.html\n');
  process.exit(code);
}
function die(msg) { process.stderr.write('zanni-inline: ' + msg + '\n'); process.exit(2); }

if (input === null) usage(2);

const manifest = JSON.parse(fs.readFileSync(path.join(assets, 'manifest.json'), 'utf8'));
if (components.length === 0) components = Object.keys(manifest.components);

let html = fs.readFileSync(input === '-' ? 0 : input, 'utf8');

const known = new Set(Object.keys(manifest.components));
for (const k of Object.keys(sets)) {
  const c = k.split('.')[0];
  if (!known.has(c)) die('--set for unknown component: ' + c);
  if (!components.includes(c)) die('--set ' + k + ' but ' + c + ' is not being inlined');
}

for (const name of components) {
  const c = manifest.components[name];
  if (!c) die('no such component: ' + name + ' (have: ' + Object.keys(manifest.components).join(', ') + ')');
  if (!html.includes(c.marker)) {
    die('marker ' + c.marker + ' not found in ' + input +
        ' — nothing would have been injected, so this is an error, not a warning');
  }
  const dir = path.join(assets, name);
  const read = (f) => fs.readFileSync(path.join(dir, f), 'utf8').trimEnd();
  const parts = ['<!-- zanni:' + name + ' begin (zanni ' + manifest.version + ') -->'];
  const head = [];
  for (const f of c.files) {
    /* A stylesheet link and its preconnects belong in the head — a warm-up
       that arrives after the request it was warming is decoration. Anything
       named *.head.html goes there; everything else lands at the marker. */
    /* A component may GENERATE its block instead of shipping it flat, when
       what it emits depends on parameters — boil's filter defs cannot be a
       static file, because SVG filter attributes are not CSS and so the only
       place a knob can live is here. */
    if (f.endsWith('.gen.js')) {
      const gen = require(path.join(dir, f));
      const mine = {};
      for (const [k, v] of Object.entries(sets)) {
        if (k.startsWith(name + '.')) mine[k.slice(name.length + 1)] = v;
      }
      try { parts.push(gen.defs(mine)); }
      catch (e) { die(e.message); }
    }
    else if (f.endsWith('.head.html')) head.push(read(f));
    else if (f.endsWith('.svg')) parts.push(read(f));
    else if (f.endsWith('.css')) parts.push('<style>\n' + read(f) + '\n</style>');
    else if (f.endsWith('.js')) parts.push('<script>\n' + read(f) + '\n</script>');
    else die('do not know how to inline ' + f);
  }
  parts.push('<!-- zanni:' + name + ' end -->');
  html = html.split(c.marker).join(parts.join('\n'));

  if (head.length) {
    if (!/<\/head>/i.test(html)) die('no </head> in ' + input + ', and ' + name + ' needs one');
    const block = '<!-- zanni:' + name + ' head -->\n' + head.join('\n') + '\n';
    html = html.replace(/<\/head>/i, block + '</head>');
  }
}

if (out) fs.writeFileSync(out, html);
else process.stdout.write(html);
