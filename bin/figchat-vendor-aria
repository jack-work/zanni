#!/usr/bin/env node
'use strict';
const fs = require('fs');
const os = require('os');
const path = require('path');
const cp = require('child_process');

const repo = process.argv[2];
if (!repo || repo === '-h' || repo === '--help') {
  process.stdout.write('usage: figchat-vendor-aria FIGARO_FORMS_CHECKOUT [OUT_DIR]\n\nBundles figaro-forms/aria (AriaClient, webSocketDial, doorUrl, edgeSession, ariaRefusal,\ncursor helpers) from a figaro-forms checkout into OUT_DIR/aria.js as one classic script that\nsets window.figaroAria (and module.exports under node), and writes OUT_DIR/SOURCE.json with\nthe checkout head. Needs rolldown in the checkout node_modules. Default OUT_DIR is assets/aria.\n');
  process.exit(repo ? 0 : 2);
}
const out = path.resolve(process.argv[3] || path.join(__dirname, '..', 'assets', 'aria'));
const src = path.join(path.resolve(repo), 'packages', 'figaro-forms', 'src');
const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'figchat-vendor-'));
const entry = path.join(tmp, 'entry.ts');
fs.writeFileSync(entry, [
  `export { AriaClient, AriaStream, ariaRefusal, AriaUnavailable, parseCursor, formatCursor, compareCursors, anchorOfCursor, spliceBytes, matches, ariaMethod } from ${JSON.stringify(path.join(src, 'aria', 'index.ts'))};`,
  `export { webSocketDial } from ${JSON.stringify(path.join(src, 'websocket.ts'))};`,
  `export { doorUrl, edgeSession } from ${JSON.stringify(path.join(src, 'auth', 'index.ts'))};`
].join('\n') + '\n');
const rolldown = require(path.join(path.resolve(repo), 'node_modules', 'rolldown'));
const git = (...a) => cp.execFileSync('git', ['-C', path.resolve(repo), ...a], { encoding: 'utf8' }).trim();

(async () => {
  const bundle = await rolldown.rolldown({ input: entry, platform: 'browser' });
  const res = await bundle.generate({
    format: 'iife',
    name: 'figaroAria',
    minify: true,
    comments: { legal: false, annotation: false, jsdoc: false },
    footer: "if (typeof module === 'object' && module.exports) module.exports = figaroAria; else if (typeof self !== 'undefined') self.figaroAria = figaroAria;"
  });
  const chunk = res.output.find((o) => o.type === 'chunk');
  fs.mkdirSync(out, { recursive: true });
  fs.writeFileSync(path.join(out, 'aria.js'), chunk.code);
  fs.writeFileSync(path.join(out, 'SOURCE.json'), JSON.stringify({ repo: 'figaro-forms', ref: (() => { try { return git('describe', '--tags', '--exact-match'); } catch (e) { return git('rev-parse', '--abbrev-ref', 'HEAD'); } })(), sha: git('rev-parse', 'HEAD'), entry: 'figaro-forms/aria' }, null, 2) + '\n');
  fs.rmSync(tmp, { recursive: true, force: true });
  process.stdout.write('aria.js ' + chunk.code.length + ' bytes from ' + git('rev-parse', '--short', 'HEAD') + '\n');
})().catch((e) => { process.stderr.write(String(e && e.stack || e) + '\n'); process.exit(1); });
