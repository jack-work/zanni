#!/usr/bin/env node
'use strict';
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

const out = process.argv[2];
if (!out || out === '-h' || out === '--help') {
  process.stdout.write('usage: figchat-bundle OUT_DIR\n\nWrites the figchat shell as a flat directory: index.html, boot.js, figchat.js,\nvoce.js, figchat.css, voce.css, z2-tokens.css, rotolo.css, fonts.css, fonts/*.woff2,\nfigaro-head.png and SHA256SUMS. Serve index.html at the app root and the directory\nunder assets/ beside it. Same-origin only, no inline script or style.\n');
  process.exit(out ? 0 : 2);
}
const assets = process.env.ZANNI_ASSETS || path.join(__dirname, '..', 'assets');
const manifest = JSON.parse(fs.readFileSync(path.join(assets, 'manifest.json'), 'utf8'));
const fonts = ['fonts/inter.woff2', 'fonts/eb-garamond.woff2', 'fonts/vt323.woff2', 'fonts/jacquard-24.woff2'];
const files = [
  ['figchat/index.html', 'index.html'],
  ['figchat/boot.js', 'boot.js'],
  ['figchat/figchat.js', 'figchat.js'],
  ['figchat/figchat.css', 'figchat.css'],
  ['voce/voce.js', 'voce.js'],
  ['voce/voce.css', 'voce.css'],
  ['v2/z2-tokens.css', 'z2-tokens.css'],
  ['rotolo/rotolo.css', 'rotolo.css'],
  ['parla/figaro-head.png', 'figaro-head.png']
];
fs.rmSync(out, { recursive: true, force: true });
fs.mkdirSync(path.join(out, 'fonts'), { recursive: true });
for (const [from, to] of files) fs.copyFileSync(path.join(assets, from), path.join(out, to));
const css = fs.readFileSync(path.join(assets, 'fontpack/fonts.css'), 'utf8').split('\n')
  .filter((line) => fonts.some((f) => line.includes('url(' + f + ')')));
if (css.length !== fonts.length) { process.stderr.write('figchat-bundle: font faces not found in fonts.css\n'); process.exit(1); }
fs.writeFileSync(path.join(out, 'fonts.css'), css.join('\n') + '\n');
for (const f of fonts) fs.copyFileSync(path.join(assets, 'fontpack', f), path.join(out, f));
const walk = (d) => fs.readdirSync(d, { withFileTypes: true }).flatMap((e) => e.isDirectory() ? walk(path.join(d, e.name)) : [path.join(d, e.name)]);
const sums = walk(out).filter((f) => path.basename(f) !== 'SHA256SUMS').sort().map((f) =>
  crypto.createHash('sha256').update(fs.readFileSync(f)).digest('hex') + '  ' + path.relative(out, f));
fs.writeFileSync(path.join(out, 'SHA256SUMS'), sums.join('\n') + '\n');
process.stdout.write('figchat ' + manifest.version + ': ' + sums.length + ' files in ' + out + '\n');
