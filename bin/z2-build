#!/usr/bin/env python3
"""z2-build: zanni2 tokens from ONE source (assets/v2/tokens.json).

  z2-build            write assets/v2/z2-tokens.css and assets/v2/z2-vega-theme.json
  z2-build --check    write nothing; exit 1 if a generated file is stale OR any contrast rule fails:
                        every text token >= 4.5:1 (WCAG AA) on --z-ground AND --z-ground-2,
                        --z-on-accent >= 4.5:1 on --z-accent,
                        every series colour >= 3:1 on both grounds (graphics, WCAG 1.4.11),
                        any two series colours >= 0.07 apart in OKLab (distinguishable),
                      in BOTH schemes (light, dark) and BOTH themes (band, figaro).
  z2-build --report   print every ratio (the audit table)
"""
import json, math, pathlib, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SRC = ROOT / "assets/v2/tokens.json"
CSS = ROOT / "assets/v2/z2-tokens.css"
VEGA = ROOT / "assets/v2/z2-vega-theme.json"
SCHEMES = ("light", "dark")


def rgb(h):
    h = h.lstrip("#")
    return [int(h[i:i + 2], 16) / 255 for i in (0, 2, 4)]


def lin(c):
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def lum(h):
    r, g, b = map(lin, rgb(h))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def ratio(a, b):
    x, y = sorted((lum(a), lum(b)), reverse=True)
    return (x + 0.05) / (y + 0.05)


def oklab(h):
    r, g, b = map(lin, rgb(h))
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
            1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
            0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)


def ld(pair):
    a, b = pair
    return a if a == b else f"light-dark({a}, {b})"


def css(t):
    sh = t["shared"]
    out = ["/* GENERATED by bin/z2-build from assets/v2/tokens.json. Do not edit: edit the source and rebuild.",
           "   zanni2 tokens: the v1 --z-* names, extended. Themes over one token set: data-theme=\"band\" (the default:",
           "   readable, data-dense) and data-theme=\"figaro\" (the v1 look). Schemes follow color-scheme; data-scheme pins one. */"]
    for name, th in t["themes"].items():
        sel = ":root, [data-theme=\"band\"]" if name == "band" else f"[data-theme=\"{name}\"]"
        out.append(f"{sel} {{")
        for k, v in th["colors"].items():
            out.append(f"  {k}: {ld(v)};")
        for k, v in th["type"].items():
            out.append(f"  --z-fs-{k}: {v}px;")
        for i, v in enumerate(th["space"], 1):
            out.append(f"  --z-space-{i}: {v}px;")
        out.append("}")
    out.append(":root {")
    for i, p in enumerate(sh["series"], 1):
        out.append(f"  --z-series-{i}: {ld(p)};")
    for i, p in enumerate(sh["seq"], 1):
        out.append(f"  --z-seq-{i}: {ld(p)};")
    for i, p in enumerate(sh["div"], 1):
        out.append(f"  --z-div-{i}: {ld(p)};")
    out.append(f"  --z-tint: {ld(sh['tint'])};")
    out.append(f"  --z-shadow: {ld(sh['shadow'])};")
    out.append(f"  --z-measure: {sh['measure']};")
    for k, v in sh["leading"].items():
        out.append(f"  --z-leading-{k}: {v};")
    for i, v in enumerate(sh["radius"], 1):
        out.append(f"  --z-radius-{i}: {v}px;")
    out.append(f"  --z-font: {sh['font']};")
    out.append(f"  --z-mono: {sh['mono']};")
    out.append("}")
    out.append(":root[data-scheme=\"light\"] { color-scheme: light; }")
    out.append(":root[data-scheme=\"dark\"] { color-scheme: dark; }")
    return "\n".join(out) + "\n"


def vega(t):
    """A Vega-Lite config per theme x scheme, so figaro-written charts inherit the look (vega-embed {config: ...})."""
    sh = t["shared"]
    out = {}
    for name, th in t["themes"].items():
        for i, sc in enumerate(SCHEMES):
            c = {k: v[i] for k, v in th["colors"].items()}
            out[f"{name}-{sc}"] = {
                "background": c["--z-ground"],
                "font": sh["font"],
                "title": {"color": c["--z-ink"], "fontSize": th["type"]["lg"], "font": sh["font"], "fontWeight": 700},
                "axis": {"domainColor": c["--z-line"], "gridColor": c["--z-rule"], "tickColor": c["--z-line"],
                         "labelColor": c["--z-muted"], "titleColor": c["--z-ink"],
                         "labelFontSize": th["type"]["xs"], "titleFontSize": th["type"]["sm"]},
                "legend": {"labelColor": c["--z-muted"], "titleColor": c["--z-ink"],
                           "labelFontSize": th["type"]["xs"], "titleFontSize": th["type"]["sm"]},
                "view": {"stroke": c["--z-rule"]},
                "range": {"category": [p[i] for p in sh["series"]], "ramp": [p[i] for p in sh["seq"]],
                          "diverging": [p[i] for p in sh["div"]], "heatmap": [p[i] for p in sh["seq"]]},
                "mark": {"color": sh["series"][0][i]},
            }
    return json.dumps(out, indent=1) + "\n"


def audit(t):
    rows, fails = [], []
    sh = t["shared"]
    for name, th in t["themes"].items():
        for i, sc in enumerate(SCHEMES):
            c = {k: v[i] for k, v in th["colors"].items()}
            grounds = (c["--z-ground"], c["--z-ground-2"])
            for k in t["text_tokens"]:
                r = min(ratio(c[k], g) for g in grounds)
                rows.append((name, sc, k, c[k], r, 4.5))
            rows.append((name, sc, "--z-on-accent/accent", c["--z-on-accent"], ratio(c["--z-on-accent"], c["--z-accent"]), 4.5))
            for n, p in enumerate(sh["series"], 1):
                rows.append((name, sc, f"--z-series-{n}", p[i], min(ratio(p[i], g) for g in grounds), 3.0))
    for i, sc in enumerate(SCHEMES):
        cols = [p[i] for p in sh["series"]]
        d = min(math.dist(oklab(a), oklab(b)) for j, a in enumerate(cols) for b in cols[j + 1:])
        rows.append(("all", sc, "series min OKLab distance", "", d, 0.07))
    for r in rows:
        if r[4] < r[5]:
            fails.append(r)
    return rows, fails


def main():
    t = json.loads(SRC.read_text())
    want = {CSS: css(t), VEGA: vega(t)}
    rows, fails = audit(t)
    if "--report" in sys.argv:
        for name, sc, k, v, r, need in rows:
            print(f"{name:6} {sc:5} {k:28} {v:8} {r:5.2f} {'ok' if r >= need else 'FAIL'} (>= {need})")
    if "--check" in sys.argv:
        stale = [p.name for p, s in want.items() if not p.exists() or p.read_text() != s]
        for f in fails:
            print(f"z2-build: CONTRAST FAIL {f[0]} {f[1]} {f[2]} {f[3]} {f[4]:.2f} < {f[5]}", file=sys.stderr)
        if stale:
            print(f"z2-build: STALE {', '.join(stale)} (run bin/z2-build)", file=sys.stderr)
        sys.exit(1 if fails or stale else 0)
    if fails:
        for f in fails:
            print(f"z2-build: CONTRAST FAIL {f[0]} {f[1]} {f[2]} {f[3]} {f[4]:.2f} < {f[5]}", file=sys.stderr)
        sys.exit(1)
    for p, s in want.items():
        p.write_text(s)
    print(f"z2-build: {CSS.name} {len(want[CSS])} B, {VEGA.name} {len(want[VEGA])} B; {len(rows)} contrast rules pass")


if __name__ == "__main__":
    main()
