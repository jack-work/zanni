#!/usr/bin/env node
/* zanni-check — prove the effect survived the build.
 *
 * Lineage: this is the '[QA] the stylesheet' block of the figaro-libretto
 * qa_agent, promoted out of a page generator and made to stand alone. It
 * exists because of a real regression: a dead-CSS sweep matched one rule per
 * line, ate the last line of the boil selector list plus the body rule, and
 * the effect vanished silently. Nobody noticed until it was SEEN.
 *
 * Everything here asserts on the built HTML as TEXT, which is the layer that
 * had no cover. It adds one guard the original never had — that the classes
 * are actually WORN by some element — because a library can now fail a
 * second way: perfectly defined, never applied.
 *
 *   zanni-check FILE.html [--component boil]...
 */
'use strict';
const fs = require('fs');
const path = require('path');

const argv = process.argv.slice(2);
let file = null, want = [];
let assets = process.env.ZANNI_ASSETS || path.join(__dirname, '..', 'assets');
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--component' || a === '-c') want.push(argv[++i]);
  else if (a === '--assets') assets = argv[++i];
  else if (a === '-h' || a === '--help') {
    process.stdout.write('usage: zanni-check FILE.html [--component NAME]...\n');
    process.exit(0);
  } else if (file === null) file = a;
}
if (!file) { process.stderr.write('usage: zanni-check FILE.html\n'); process.exit(2); }

const manifest = JSON.parse(fs.readFileSync(path.join(assets, 'manifest.json'), 'utf8'));
const html = fs.readFileSync(file, 'utf8');
const css = (html.match(/<style[^>]*>([\s\S]*?)<\/style>/g) || []).join('\n');
/* Assertions about what the document DOES must not be satisfied — or broken —
 * by what it SAYS. This library documents itself in comments that name the
 * very attributes being checked, so counting assertions read the stripped
 * text. The two guards about the old regression deliberately keep the raw
 * CSS, because a dangling comma is a fact about the file as written. */
const bare = html.replace(/<!--[\s\S]*?-->/g, '').replace(/\/\*[\s\S]*?\*\//g, '');
const filters = bare.match(/<filter\b[\s\S]*?<\/filter>/g) || [];
const filterText = filters.join('\n');
const byId = (id) => filters.find((f) => f.includes('id="' + id + '"')) || '';

let pass = 0, fail = 0;
const check = (n, c, d) => c ? (pass++, console.log('  ok   ' + n))
                             : (fail++, console.log('  FAIL ' + n + (d ? ' :: ' + d : '')));

if (want.length === 0) {
  want = Object.keys(manifest.components).filter((n) =>
    html.includes('<!-- zanni:' + n + ' begin'));
  if (want.length === 0) {
    console.log('zanni-check: no zanni component found in ' + file);
    process.exit(1);
  }
}

console.log('[zanni] ' + file);

for (const name of want) {
  const c = manifest.components[name];
  if (!c) { check('component ' + name + ' exists in the manifest', false); continue; }
  console.log('[' + name + '] injected');
  check('the block was injected', html.includes('<!-- zanni:' + name + ' begin'));
  check('no marker left uninlined', !html.includes(c.marker));

  /* Generic, manifest-driven, and the two failures no component can afford:
     a class the manifest promises but the stylesheet never defines, and a
     component that is perfectly defined and worn by nobody. The second is
     the shape the original regression took — the effect was gone and every
     test still passed. */
  const edge = '(?![\\w-])';
  const undef = (c.classes || []).filter((cls) =>
    !new RegExp('\\.' + cls + edge + '[^{}]*\\{').test(css));
  check('every class the manifest promises has a rule', undef.length === 0, undef.join(', '));
  const worn = (c.classes || []).filter((cls) =>
    new RegExp('class="[^"]*\\b' + cls + edge).test(html));
  check('some element actually wears it', worn.length > 0,
    'nothing carries ' + (c.classes || []).map((x) => '.' + x).join(' / '));

  if (name === 'boil') boil();
  if (name === 'gesso') gesso();
  if (name === 'phosphor') phosphor();
  if (name === 'fontpack') fontpack();
  if (name === 'glyphmark') glyphmark();
}

function glyphmark() {
  console.log('[glyphmark] the mark');
  check('it scales with nearest-neighbour', /image-rendering:\s*pixelated/.test(css));
  check('the mark is sized in whole pixels, tunably',
    /\.glyphmark\s*\{[^{}]*var\(--glyphmark-size/.test(css));
  /* The trap this component exists to prevent: pixelated on a full-size
     photo does nothing. If a page wears .glyphmark, the image it wears it
     on should have come through lib.pixelate — which names its output
     *-pixel.png — or be small by hand. This is a warning-shaped check: it
     can only see the filename, so it says what it can see. */
  const marks = html.match(/<img[^>]*class="[^"]*glyphmark[^"]*"[^>]*>/g) || [];
  const small = (m) => {
    const uri = (m.match(/src="(data:image\/[^"]*)"/) || [])[1];
    if (uri) return uri.length < 24000;         /* an 80px PNG is ~4KB of base64 */
    return /src="[^"]*(pixel|glyph)[^"]*"/.test(m);
  };
  check('the mark points at a small source', marks.every(small),
    'image-rendering: pixelated does nothing to a large photo — see docs/glyphmark.md');
}

function gesso() {
  console.log('[gesso] the ground');
  check('the dither is a conic checker, not an image',
    /repeating-conic-gradient\(\s*var\(--dither\)/.test(css));
  check('the checker has a cell size', /background-size:\s*var\(--gesso-cell\)/.test(css));
  ['--paper', '--dither', '--ink', '--gold', '--oxblood'].forEach((v) =>
    check(v + ' is defined', new RegExp('\\' + v + ':').test(css)));
  check('selection belongs to the palette', /::selection/.test(css));
}

function phosphor() {
  console.log('[phosphor] the veil');
  check('the comb is a repeating linear gradient',
    /\.phosphor[\s\S]{0,400}repeating-linear-gradient\(\s*\n?\s*0deg/.test(css));
  check('it multiplies into what is beneath', /mix-blend-mode:\s*multiply/.test(css));
  /* A veil that eats clicks is a bug report waiting to be filed. */
  check('it cannot eat clicks', /\.phosphor[\s\S]{0,200}pointer-events:\s*none/.test(css));
  check('the host is positioned', /\.phosphor-host\s*\{[^{}]*position:\s*relative/.test(css));
  check('the bloom stops under reduced motion',
    /prefers-reduced-motion[\s\S]{0,120}\.phosphor-bloom\s*\{[^{}]*animation:\s*none/.test(css));
}

function fontpack() {
  console.log('[fontpack] the three faces');
  (manifest.components.fontpack.families || []).forEach((f) =>
    check("'" + f + "' is named", html.includes("'" + f + "'") || html.includes(f.replace(/ /g, '+'))));
  check('the faces are fetched from the head',
    /<!-- zanni:fontpack head -->[\s\S]*?<\/head>/.test(html));
  check('the preconnects precede the stylesheet',
    html.indexOf('rel="preconnect"') < html.indexOf('fonts.googleapis.com/css2'));
  check('type is swapped in, not hidden', /display=swap/.test(html));
  /* VT323 is bitmap-derived and disintegrates below ~13px. */
  check('the technical face keeps its floor',
    /\.fontpack-mono\s*\{[^{}]*font-size:\s*max\(13px/.test(css));
}

function boil() {
  console.log('[boil] the filters');
  ['pixel-text', 'pixel-stage', 'pixel-ui'].forEach((id) =>
    check(id + ' is defined', new RegExp('<filter id="' + id + '"').test(html)));

  check('every filter steps its seed discretely',
    (filterText.match(/calcMode="discrete"/g) || []).length === 3);
  check('the noise is displaced, not merely blurred',
    (filterText.match(/feDisplacementMap/g) || []).length === 3);
  check('type is re-crisped after its blur',
    /feGaussianBlur[\s\S]*?feComponentTransfer[\s\S]*?feFuncA type="table"/.test(byId('pixel-text')));

  /* The stage filter must stay a pure displacement: an alpha threshold there
     destroys low-alpha fills and dimmed layers. One blur in the document, and
     it belongs to the type filter. */
  check('only the type filter blurs', (filterText.match(/feGaussianBlur/g) || []).length === 1);
  check('the stage filter has no alpha table', !/feFuncA/.test(byId('pixel-stage')));

  /* Filter regions: without the enlarged box the displaced edge is clipped,
     and the type filter's box is deliberately taller than it is wide. */
  const region = (id) => (byId(id).match(/<filter[^>]*>/) || [''])[0];
  check('the type filter enlarges its region',
    /x="-6%"/.test(region('pixel-text')) && /height="128%"/.test(region('pixel-text')));
  check('the chrome filters enlarge their regions',
    /width="104%"/.test(region('pixel-stage')) && /width="106%"/.test(region('pixel-ui')));

  /* Unset on purpose: the chain runs in the SVG default linearRGB, and the
     alpha ramp was tuned there. */
  check('colour interpolation is left at the SVG default',
    !/color-interpolation-filters/.test(filterText));

  /* The host must take no layout and not be announced. */
  check('the defs host is inert',
    /<svg width="0" height="0"[^>]*position:absolute[^>]*aria-hidden="true"/.test(html));

  console.log('[boil] the application layer');
  [['boil-text', 'pixel-text'], ['boil-ui', 'pixel-ui'], ['boil-stage', 'pixel-stage']]
    .forEach(([cls, id]) => check('.' + cls + ' applies #' + id,
      new RegExp('\\.' + cls + '\\s*\\{[^{}]*filter:\\s*url\\(#' + id + '\\)').test(css)));

  console.log('[boil] reduced motion');
  /* CSS cannot stop SMIL. If the script that removes the animates is gone,
     reduced-motion readers get the boil anyway. */
  check('the SMIL animates are removed under reduced motion',
    /prefers-reduced-motion/.test(html) && /filter animate/.test(html));

  console.log('[boil] the shape of the old bug');
  const dangling = css.match(/,\s*\n\s*\n/g) || [];
  check('no selector list left dangling on a comma', dangling.length === 0,
    dangling.length + ' found');
  check('body is still its own rule', /(^|\n)\s*body\s*\{/.test(css));
}

console.log('[zanni] ' + pass + ' passed, ' + fail + ' failed');
process.exit(fail ? 1 : 0);
