#!/usr/bin/env node
'use strict';
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

const out = process.argv[2];
if (!out || out === '-h' || out === '--help') {
  process.stdout.write('usage: zanni-react-bundle OUT_DIR [WEB_DIR]\n\nLays the Vite builds of packages/react (WEB_DIR/dist-react, dist-react-jotai) and the tsc declarations\n(WEB_DIR/dist-types) out as OUT_DIR/{react,react-jotai}/<version>/{index.js,index.css,index.d.ts,SHA256SUMS}, the version\nbeing assets/manifest.json\'s, and WEB_DIR/dist-runtime as OUT_DIR/runtime/<version>/{react.js,jsx-runtime.js,react-dom-client.js,figaro-forms-glyphs.js,pretext.js,SHA256SUMS}. index.d.ts is one file of ambient module declarations: "zanni-react" and "zanni-react/jotai".\nThe jotai bundle also carries pcm-worklet.js, which the page loads beside the module.\n');
  process.exit(out ? 0 : 2);
}
const root = path.join(__dirname, '..');
const web = path.resolve(process.argv[3] || path.join(root, 'web'));
const manifest = JSON.parse(fs.readFileSync(path.join(process.env.ZANNI_ASSETS || path.join(root, 'assets'), 'manifest.json'), 'utf8'));
const version = manifest.version;
const typesRoot = path.join(web, 'dist-types', 'packages', 'react', 'src');

function die(msg) { process.stderr.write('zanni-react-bundle: ' + msg + '\n'); process.exit(1); }

function declarationFiles(dir) {
  const files = [];
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) files.push(...declarationFiles(p));
    else if (e.name.endsWith('.d.ts')) files.push(p);
  }
  return files.sort();
}

const isJotai = (rel) => rel === 'jotai' || rel.startsWith('jotai/');

function moduleName(rel, jotai) {
  if (!jotai) return rel === 'index' ? 'zanni-react' : 'zanni-react/_/' + rel;
  return rel === 'jotai' ? 'zanni-react/jotai' : 'zanni-react/jotai/_/' + rel;
}

function flatten(jotai) {
  const blocks = [];
  for (const file of declarationFiles(typesRoot)) {
    const rel = path.relative(typesRoot, file).replace(/\.d\.ts$/, '');
    if (jotai !== isJotai(rel)) continue;
    const from = path.dirname(rel);
    const body = fs.readFileSync(file, 'utf8').replace(/(\bfrom\s+|\bimport\(\s*)(["'])(\.{1,2}\/[^"']*)\2/g, (_, lead, q, spec) => {
      let target = path.posix.normalize(path.posix.join(from, spec));
      if (fs.existsSync(path.join(typesRoot, target, 'index.d.ts')) && !fs.existsSync(path.join(typesRoot, target + '.d.ts'))) target += '/index';
      if (!fs.existsSync(path.join(typesRoot, target + '.d.ts'))) die(rel + ' imports ' + spec + ' which has no declaration file');
      return lead + q + moduleName(target, jotai && isJotai(target)) + q;
    });
    blocks.push('declare module ' + JSON.stringify(moduleName(rel, jotai)) + ' {\n' + body.replace(/^(export )?declare /gm, '$1').replace(/^(?=.)/gm, '  ').replace(/\s+$/, '') + '\n}\n');
  }
  return blocks.join('\n');
}

const sha = (b) => crypto.createHash('sha256').update(b).digest('hex');
const plan = [
  { name: 'react', dist: 'dist-react', jotai: false, extra: [] },
  { name: 'react-jotai', dist: 'dist-react-jotai', jotai: true, extra: ['pcm-worklet.js'] },
];
fs.rmSync(out, { recursive: true, force: true });
const lines = [];
for (const p of plan) {
  const dist = path.join(web, p.dist);
  const dir = path.join(out, p.name, version);
  fs.mkdirSync(dir, { recursive: true });
  const built = fs.readdirSync(dist).sort();
  const expected = ['index.js'].concat(fs.existsSync(path.join(dist, 'index.css')) ? ['index.css'] : [], p.extra).sort();
  if (JSON.stringify(built) !== JSON.stringify(expected)) die(p.dist + ' holds ' + built.join(', ') + ', expected ' + expected.join(', '));
  for (const f of built) fs.copyFileSync(path.join(dist, f), path.join(dir, f));
  if (!built.includes('index.css')) fs.writeFileSync(path.join(dir, 'index.css'), '');
  fs.writeFileSync(path.join(dir, 'index.d.ts'), flatten(p.jotai));
  const files = fs.readdirSync(dir).sort();
  fs.writeFileSync(path.join(dir, 'SHA256SUMS'), files.map((f) => sha(fs.readFileSync(path.join(dir, f))) + '  ' + f).join('\n') + '\n');
  lines.push(p.name + '/' + version + ': ' + (files.length + 1) + ' files');
}
const runtimeDist = path.join(web, 'dist-runtime');
const runtimeDir = path.join(out, 'runtime', version);
fs.mkdirSync(runtimeDir, { recursive: true });
const runtimeBuilt = fs.readdirSync(runtimeDist).sort();
const runtimeExpected = ['figaro-forms-glyphs.js', 'jsx-runtime.js', 'pretext.js', 'react-dom-client.js', 'react.js'];
if (JSON.stringify(runtimeBuilt) !== JSON.stringify(runtimeExpected)) die('dist-runtime holds ' + runtimeBuilt.join(', ') + ', expected ' + runtimeExpected.join(', '));
for (const f of runtimeBuilt) fs.copyFileSync(path.join(runtimeDist, f), path.join(runtimeDir, f));
fs.writeFileSync(path.join(runtimeDir, 'SHA256SUMS'), runtimeBuilt.map((f) => sha(fs.readFileSync(path.join(runtimeDir, f))) + '  ' + f).join('\n') + '\n');
lines.push('runtime/' + version + ': ' + (runtimeBuilt.length + 1) + ' files');
process.stdout.write('zanni-react ' + version + ': ' + lines.join('; ') + '\n');
