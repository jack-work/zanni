{
  "name": "zanni",
  "version": "0.7.0",
  "description": "Visual components extracted from figar.org.",
  "components": {
    "boil": {
      "summary": "Animated fractal-noise displacement over type and chrome (line boil / Squigglevision). Not a blur.",
      "marker": "<!-- zanni:boil -->",
      "classes": [
        "boil-slack",
        "boil-text",
        "boil-text-squiggle",
        "boil-text-fine",
        "boil-text-strong",
        "boil-text-erode",
        "boil-ui",
        "boil-ui-squiggle",
        "boil-ui-fine",
        "boil-ui-strong",
        "boil-ui-erode",
        "boil-stage",
        "boil-stage-squiggle",
        "boil-stage-fine",
        "boil-stage-strong",
        "boil-stage-erode"
      ],
      "filters": [
        "pixel-text",
        "pixel-text-squiggle",
        "pixel-text-fine",
        "pixel-text-strong",
        "pixel-text-erode",
        "pixel-stage",
        "pixel-stage-squiggle",
        "pixel-stage-fine",
        "pixel-stage-strong",
        "pixel-stage-erode",
        "pixel-ui",
        "pixel-ui-squiggle",
        "pixel-ui-fine",
        "pixel-ui-strong",
        "pixel-ui-erode"
      ],
      "files": [
        "boil.gen.js",
        "boil.css",
        "boil.js"
      ],
      "docs": "docs/boil.md",
      "knobs": [
        "boil.driver",
        "boil.text.freq",
        "boil.text.scale",
        "boil.text.dur",
        "boil.text.blur",
        "boil.stage.freq",
        "boil.stage.scale",
        "boil.ui.freq",
        "boil.ui.scale"
      ]
    },
    "gesso": {
      "summary": "The prepared ground: parchment plus a 6px conic dither, and the palette it was chosen against.",
      "marker": "<!-- zanni:gesso -->",
      "classes": [
        "gesso",
        "gesso-stage"
      ],
      "files": [
        "gesso.css"
      ],
      "docs": "docs/gesso.md"
    },
    "phosphor": {
      "summary": "The CRT veil: a 1px/3px scanline comb multiplied over a positioned box, with an optional bloom.",
      "marker": "<!-- zanni:phosphor -->",
      "classes": [
        "phosphor",
        "phosphor-host",
        "phosphor-soft",
        "phosphor-bloom"
      ],
      "files": [
        "phosphor.css"
      ],
      "docs": "docs/phosphor.md",
      "knobs": [
        "--phosphor-ink",
        "--phosphor-pitch",
        "--phosphor-line",
        "--phosphor-strength"
      ]
    },
    "fontpack": {
      "summary": "Three faces, three jobs: Jacquard 24 display, EB Garamond prose, VT323 technical.",
      "marker": "<!-- zanni:fontpack -->",
      "classes": [
        "fontpack-display",
        "fontpack-prose",
        "fontpack-mono"
      ],
      "families": [
        "Jacquard 24",
        "EB Garamond",
        "VT323"
      ],
      "files": [
        "fontpack.head.html",
        "fontpack.css"
      ],
      "docs": "docs/fontpack.md"
    },
    "glyphmark": {
      "summary": "The portrait as a pixel mark: a genuinely small source image scaled up with nearest-neighbour, bordered in gold.",
      "marker": "<!-- zanni:glyphmark -->",
      "classes": [
        "glyphmark",
        "glyphmark-round"
      ],
      "files": [
        "glyphmark.css"
      ],
      "docs": "docs/glyphmark.md"
    },
    "heft": {
      "summary": "Pick a thing up, throw it about, let go, watch it settle back. Composes via CSS translate; lifts the ancestor, not the child.",
      "marker": "<!-- zanni:heft -->",
      "classes": [
        "heft",
        "heft-lift"
      ],
      "knobs": [
        "--heft-settle",
        "--heft-ease"
      ],
      "files": [
        "heft.css",
        "heft.js"
      ],
      "docs": "docs/heft.md"
    }
  },
  "planned": [
    "scena"
  ]
}
