{
  "name": "zanni",
  "version": "0.15.2",
  "description": "Visual components extracted from figar.org.",
  "components": {
    "boil": {
      "summary": "Animated fractal-noise displacement over type and chrome (line boil / Squigglevision). Not a blur.",
      "marker": "<!-- zanni:boil -->",
      "classes": [
        "boil-slack",
        "boil-text",
        "boil-text-squiggle",
        "boil-text-fine",
        "boil-text-strong",
        "boil-text-erode",
        "boil-ui",
        "boil-ui-squiggle",
        "boil-ui-fine",
        "boil-ui-strong",
        "boil-ui-erode",
        "boil-stage",
        "boil-stage-squiggle",
        "boil-stage-fine",
        "boil-stage-strong",
        "boil-stage-erode"
      ],
      "filters": [
        "pixel-text",
        "pixel-text-squiggle",
        "pixel-text-fine",
        "pixel-text-strong",
        "pixel-text-erode",
        "pixel-stage",
        "pixel-stage-squiggle",
        "pixel-stage-fine",
        "pixel-stage-strong",
        "pixel-stage-erode",
        "pixel-ui",
        "pixel-ui-squiggle",
        "pixel-ui-fine",
        "pixel-ui-strong",
        "pixel-ui-erode"
      ],
      "files": [
        "boil.gen.js",
        "boil.css",
        "boil.js"
      ],
      "docs": "docs/boil.md",
      "knobs": [
        "boil.driver",
        "boil.text.freq",
        "boil.text.scale",
        "boil.text.dur",
        "boil.text.blur",
        "boil.stage.freq",
        "boil.stage.scale",
        "boil.ui.freq",
        "boil.ui.scale"
      ]
    },
    "gesso": {
      "summary": "The prepared ground: parchment plus a 6px conic dither, the palette it was chosen against, and scheme tokens (--z-*) that follow color-scheme into the velvet stage.",
      "marker": "<!-- zanni:gesso -->",
      "classes": [
        "gesso",
        "gesso-stage"
      ],
      "files": [
        "gesso.css"
      ],
      "docs": "docs/gesso.md",
      "knobs": [
        "--gesso-cell",
        "--z-ground",
        "--z-ink",
        "--z-accent"
      ]
    },
    "phosphor": {
      "summary": "The CRT veil: a 1px/3px scanline comb multiplied over a positioned box, with an optional bloom.",
      "marker": "<!-- zanni:phosphor -->",
      "classes": [
        "phosphor",
        "phosphor-host",
        "phosphor-soft",
        "phosphor-bloom"
      ],
      "files": [
        "phosphor.css"
      ],
      "docs": "docs/phosphor.md",
      "knobs": [
        "--phosphor-ink",
        "--phosphor-pitch",
        "--phosphor-line",
        "--phosphor-strength"
      ]
    },
    "fontpack": {
      "summary": "Three faces, three jobs: Jacquard 24 display, EB Garamond prose, VT323 technical. Self-hosted: inlined as data: URIs, or served from fonts/ with fonts.css.",
      "marker": "<!-- zanni:fontpack -->",
      "classes": [
        "fontpack-display",
        "fontpack-prose",
        "fontpack-mono"
      ],
      "families": [
        "Jacquard 24",
        "EB Garamond",
        "VT323"
      ],
      "files": [
        "fontpack.gen.js",
        "fontpack.css"
      ],
      "docs": "docs/fontpack.md",
      "knobs": [
        "fontpack.faces",
        "--fontpack-display",
        "--fontpack-prose",
        "--fontpack-mono"
      ]
    },
    "glyphmark": {
      "summary": "The portrait as a pixel mark: a genuinely small source image scaled up with nearest-neighbour, bordered in gold.",
      "marker": "<!-- zanni:glyphmark -->",
      "classes": [
        "glyphmark",
        "glyphmark-round"
      ],
      "files": [
        "glyphmark.css"
      ],
      "docs": "docs/glyphmark.md",
      "knobs": [
        "--glyphmark-size",
        "--glyphmark-border",
        "--glyphmark-ring",
        "--glyphmark-ring-gap"
      ]
    },
    "heft": {
      "summary": "Pick a thing up, throw it about, let go, watch it settle back. Composes via CSS translate; lifts the ancestor, not the child.",
      "marker": "<!-- zanni:heft -->",
      "classes": [
        "heft",
        "heft-lift"
      ],
      "knobs": [
        "--heft-settle",
        "--heft-ease"
      ],
      "files": [
        "heft.css",
        "heft.js"
      ],
      "docs": "docs/heft.md"
    },
    "scriba": {
      "summary": "Markdown into the page: a port of gluck-herald's internal/md, made safe for a browser.",
      "marker": "<!-- zanni:scriba -->",
      "classes": [
        "scriba"
      ],
      "files": [
        "scriba.css",
        "scriba.js"
      ],
      "docs": "docs/scriba.md",
      "knobs": [
        "--scriba-code-bg"
      ]
    },
    "stilo": {
      "summary": "A textarea that gains a Write/Preview pair and a technical face. Preview is scriba's job.",
      "marker": "<!-- zanni:stilo -->",
      "classes": [
        "stilo",
        "stilo-bar",
        "stilo-tab",
        "stilo-input",
        "stilo-preview",
        "stilo-empty"
      ],
      "files": [
        "stilo.css",
        "stilo.js"
      ],
      "docs": "docs/stilo.md",
      "requires": [
        "scriba"
      ],
      "knobs": [
        "--stilo-face",
        "--stilo-field",
        "--stilo-min"
      ],
      "constructed": true,
      "activator": "data-stilo"
    },
    "parla": {
      "summary": "Figaro speaks: the pixel head, liftable with heft, and a cartoon speech bubble from his mouth that can say, quip, be interrupted with an *AHEM*, and wiggle.",
      "marker": "<!-- zanni:parla -->",
      "classes": [
        "parla",
        "parla-head",
        "parla-bubble",
        "parla-wiggle",
        "parla-again",
        "parla-ahem"
      ],
      "files": [
        "parla.css",
        "parla.js"
      ],
      "assets": [
