      "knobs": [
        "--parla-head",
        "--parla-mouth",
        "--parla-tilt",
        "--parla-outline"
      ],
      "activator": "data-parla"
    },
    "filo": {
      "summary": "The player: video or audio chrome over a page's own media element. A scrubber with buffered dither, chapter notches and thumbnail previews, a centre cluster on pause, a settings menu (speed, quality, sleep, chapters), key help, fullscreen, and one keymap for keyboards, D-pads and remotes.",
